{
  "name": "o-que-e-que-tem-backend",
  "version": "1.0.0",
  "description": "Backend de uma plataforma sustentável voltada à redução do desperdício de alimentos, com sistema de assinatura flexível, catálogo de produtos e gestão de pedidos.",
  "keywords": [
    "backend",
    "api",
    "rest-api",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "javascript",
    "cookie-parser",
    "sustainability",
    "food-waste",
    "subscription",
    "ecommerce"
  ],
  "author": "Vanessa Yuri A. Brito",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "22.23.3"
  },
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VanessaYuriAB/o-que-e-que-tem-backend.git"
  },
  "bugs": {
    "url": "https://github.com/VanessaYuriAB/o-que-e-que-tem-backend/issues"
  },
  "homepage": "https://github.com/VanessaYuriAB/o-que-e-que-tem-backend#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "celebrate": "16.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.0",
    "validator": "13.15.35"
  }
}
