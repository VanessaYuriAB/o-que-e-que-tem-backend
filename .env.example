# -------------------------------
# Configurações do Servidor
# -------------------------------

# Porta em que o servidor Express irá rodar
PORT=3001

# Ambiente da aplicação: development | production | test
# NODE_ENV é definido diretamente nos scripts, pelo cross-env

# -------------------------------
# Configurações do Banco de Dados
# -------------------------------

# URI de conexão com o MongoDB Atlas (inclui usuário, senha e cluster) ou local (para desenvolvimento)
MONGODB_URI=mongodb://localhost:27017
# mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net

# Nome do banco de dados (não é o nome da coleção)
DB_NAME=<nome-do-banco>

# -------------------------------
# Configurações de CORS
# -------------------------------

# Lista de origens permitidas (separadas por vírgula)
CORS_ORIGIN=https://example.com

# -------------------------------
# Rate Limiting
# -------------------------------

# Número máximo de requisições permitidas por IP em um intervalo de tempo
RATE_LIMIT_MAX=100

# -------------------------------
# Segurança e Autenticação
# -------------------------------

# Chave secreta para assinar tokens JWT
JWT_SECRET=<sua-chave-secreta>
# Gerada com módulo 'crypto' integrado ao Node.js, usado para criar chaves

# -------------------------------
# Resend
# -------------------------------

# Chave da API do Resend utilizada para autenticação nas requisições de envio de e-mail
# Gerada e fornecida pelo próprio Resend
RESEND_API_KEY=<resend-api-key>

# Remetente dos e-mails enviados pela aplicação
# Deve ser um endereço autorizado no Resend
RESEND_FROM_EMAIL=<contato@seudominio.com>

# E-mail que receberá as notificações administrativas
ADMIN_EMAIL=<admin@seudominio.com>